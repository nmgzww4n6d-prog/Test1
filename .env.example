# =============================================================================
# Miljøvariabler / API-nøkler
# =============================================================================
# Kopier denne filen til ".env" og fyll inn ekte verdier.
#   cp .env.example .env
#
# .env skal ALDRI committes til git (se .gitignore).
# MVP-en trenger ingen av disse ennå – de er placeholders for fremtidige
# integrasjoner. Se TODO-kommentarene i agents/seo_content_agent.py.
# -----------------------------------------------------------------------------

# Google Analytics 4 (GA4 Data API)
GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=

# Google Search Console API
GSC_SITE_URL=
GSC_CREDENTIALS_JSON=

# Semrush API
SEMRUSH_API_KEY=

# WordPress REST API
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Slack – innkommende webhook for å poste rapporten
SLACK_WEBHOOK_URL=
